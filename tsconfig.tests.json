{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "paths": {
      "@smartflow/daemon": ["./apps/daemon/src/index.ts"],
      "@smartflow/mcp-server": ["./apps/mcp-server/src/index.ts"],
      "@smartflow/*": ["./packages/*/src/index.ts"]
    }
  },
  "include": [
    "apps/**/*.ts",
    "packages/**/*.ts",
    "tests/**/*.ts",
    "clear-daemon-data.ts",
    "vitest.config.ts"
  ]
}
