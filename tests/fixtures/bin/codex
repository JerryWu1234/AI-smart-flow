#!/usr/bin/env node

import { randomUUID } from "node:crypto";
import { appendFile, readFile, writeFile } from "node:fs/promises";
import { resolve } from "node:path";

const argv = process.argv.slice(2);
if (argv[0] !== "exec") throw new Error(`Unsupported fake Codex argv: ${JSON.stringify(argv)}`);

const resume = argv[1] === "resume";

// Mirror the real CLI's accepted flags so an argv the real `codex` would reject
// fails here too. `codex exec resume` accepts neither --sandbox nor --cd.
const VALUED_FLAGS = new Set(["-m", "--model", "-c", "--config", "--output-schema", "--output-last-message", "-o"]);
const CREATE_ONLY_FLAGS = new Set(["--sandbox", "--cd"]);
const BOOLEAN_FLAGS = new Set(["--json", "--skip-git-repo-check", "--ignore-user-config"]);

const positional = resume ? argv.slice(3) : argv.slice(1);
const flagValues = new Map();
const configOverrides = new Map();
let prompt;

for (let index = 0; index < positional.length; index += 1) {
  const token = positional[index];
  if (!token.startsWith("-")) {
    prompt = token;
    continue;
  }
  if (BOOLEAN_FLAGS.has(token)) continue;
  const valued = VALUED_FLAGS.has(token) || CREATE_ONLY_FLAGS.has(token);
  if (!valued || (resume && CREATE_ONLY_FLAGS.has(token))) {
    throw new Error(`error: unexpected argument '${token}' found`);
  }
  index += 1;
  const value = positional[index];
  if (value === undefined) throw new Error(`Fake Codex requires a value for ${token}`);
  if (token === "-c" || token === "--config") {
    const separator = value.indexOf("=");
    if (separator < 0) throw new Error(`Fake Codex requires key=value for ${token}`);
    configOverrides.set(value.slice(0, separator), value.slice(separator + 1).replace(/^"|"$/gu, ""));
    continue;
  }
  flagValues.set(token, value);
}

function option(...names) {
  for (const name of names) {
    const value = flagValues.get(name);
    if (value !== undefined) return value;
  }
  throw new Error(`Fake Codex requires one of ${names.join(", ")}`);
}

const sessionId = resume ? argv[2] : `installed-review-${randomUUID()}`;
if (sessionId === undefined || sessionId.length === 0) {
  throw new Error("Fake Codex resume requires a session ID");
}
// Create names the worktree explicitly; resume relies on the spawned cwd because
// the real `codex exec resume` rejects --cd.
const cwd = resume ? process.cwd() : option("--cd");
const outputPath = option("--output-last-message", "-o");
const model = flagValues.get("-m") ?? flagValues.get("--model");
const effort = configOverrides.get("model_reasoning_effort");
const sandboxMode = configOverrides.get("sandbox_mode") ?? flagValues.get("--sandbox");
if (sandboxMode !== "read-only") {
  throw new Error(`Fake Codex expected a read-only sandbox, received ${String(sandboxMode)}`);
}
if (prompt === undefined) throw new Error("Fake Codex requires a prompt");
const marker = process.env.SMARTFLOW_TEST_REPAIR_MARKER;
if (marker === undefined || marker.length === 0) {
  throw new Error("SMARTFLOW_TEST_REPAIR_MARKER is required");
}

const taskIds = [...new Set(
  [...prompt.matchAll(/"id":\s*"(T\d{3,})"/gu)].map((match) => match[1])
)];
if (taskIds.length === 0 || taskIds.some((taskId) => taskId === undefined)) {
  throw new Error("Fake Codex could not read approved Task IDs from the prompt");
}
const reviewsPrimaryTask = taskIds.includes("T057");
const source = reviewsPrimaryTask ? await readFile(resolve(cwd, "sum.js"), "utf8") : "";
const markerPresent = !reviewsPrimaryTask || source.includes(marker);
const issue = {
  path: "sum.js",
  message: `The authorized dynamic repair marker is missing from sum.js: ${marker}`,
  suggestedFix: `Add this exact standalone comment to sum.js: ${marker}`
};
const result = {
  tasks: taskIds.map((id) => markerPresent
    ? { id, completionPercentage: 100, issues: [] }
    : { id, completionPercentage: 50, issues: [issue] })
};
await writeFile(outputPath, JSON.stringify(result), "utf8");

const tracePath = process.env.SMARTFLOW_TEST_CODEX_TRACE;
if (tracePath !== undefined && tracePath.length > 0) {
  await appendFile(tracePath, `${JSON.stringify({
    mode: resume ? "RESUME" : "CREATE",
    sessionId,
    cwd,
    outputPath,
    model,
    effort,
    taskIds,
    markerPresent
  })}\n`, "utf8");
}

process.stdout.write(`${JSON.stringify({ type: "thread.started", thread_id: sessionId })}\n`);
process.stdout.write(`${JSON.stringify({
  type: "turn.completed",
  usage: { input_tokens: 1, output_tokens: 1 }
})}\n`);
