{
  "name": "@smartflow/daemon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsdown --config ../../tsdown.workspace.config.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --root ../.. --passWithNoTests tests/unit/apps/daemon"
  },
  "dependencies": {
    "@smartflow/observability": "workspace:*",
    "@smartflow/provider-core": "workspace:*",
    "@smartflow/provider-pi": "workspace:*",
    "@smartflow/protocol": "workspace:*",
    "@smartflow/publish": "workspace:*",
    "@smartflow/review": "workspace:*",
    "@smartflow/state-store": "workspace:*",
    "@smartflow/task-manifest": "workspace:*",
    "@smartflow/workspace": "workspace:*",
    "yaml": "2.9.0"
  }
}
